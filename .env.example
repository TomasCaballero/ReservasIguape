# Copiar a .env (ignorado por git) y completar.
# Postgres local (base creada en pgAdmin). En local ambas URLs apuntan a la misma base.
# Cuando se migre a Supabase: DATABASE_URL = pooler, DIRECT_URL = conexión directa.
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_BASE"
# Conexión directa (migraciones y seed)
DIRECT_URL="postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_BASE"
# Firma de sesión del admin (string aleatorio largo)
SESSION_SECRET=""
# Protege POST /api/cron/tick: el scheduler lo llama cada 15 min como máximo con
# `Authorization: Bearer <CRON_SECRET>`. Sin este valor el endpoint rechaza todo (401). String aleatorio largo.
CRON_SECRET=""
# Primer admin (lo crea `npx prisma db seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
