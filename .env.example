# Copiar a .env (ignorado por git) y completar.
# Pooler de Supabase (runtime de la app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Conexión directa (migraciones y seed)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Firma de sesión del admin (string aleatorio largo)
SESSION_SECRET=""
# Protege los endpoints de cron
CRON_SECRET=""
# Primer admin (lo crea `npx prisma db seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
